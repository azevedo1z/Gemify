  "fixed_sql": [
    {
      "name": "months",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"months\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"reference_year\" INTEGER NOT NULL, \"reference_month\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"income_cents\" INTEGER NULL, \"opened_at\" TEXT NOT NULL, \"closed_at\" TEXT NULL, UNIQUE (\"reference_year\", \"reference_month\"), CHECK (reference_month BETWEEN 1 AND 12), CHECK (status IN ('open', 'closed')), CHECK ((status = 'open') = (closed_at IS NULL)), CHECK (status = 'open' OR income_cents IS NOT NULL), CHECK (income_cents BETWEEN 0 AND 99999999999));"
        }
      ]
    },
    {
      "name": "expenses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expenses\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"month_id\" INTEGER NOT NULL REFERENCES months (id), \"category\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL, \"current_installment\" INTEGER NULL, \"total_installments\" INTEGER NULL, \"spent_on\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, CHECK (category IN ('fixed', 'installment', 'variable')), CHECK (amount_cents BETWEEN 1 AND 99999999999), CHECK ((category = 'installment') = (current_installment IS NOT NULL)), CHECK ((category = 'installment') = (total_installments IS NOT NULL)), CHECK (total_installments >= 2), CHECK (current_installment BETWEEN 1 AND total_installments), CHECK (category = 'variable' OR spent_on IS NULL));"
        }
      ]
    },
    {
      "name": "change_log",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"change_log\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"occurred_at\" TEXT NOT NULL, \"month_id\" INTEGER NULL REFERENCES months (id), \"action\" TEXT NOT NULL, \"entity_id\" INTEGER NULL, \"before_json\" TEXT NULL, \"after_json\" TEXT NULL);"
        }
      ]
    },
